# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/blog?retryWrites=true&w=majority

# Server port
PORT=3001

# CORS — comma-separated list of allowed origins
# For local dev: http://localhost:3000,http://127.0.0.1:5500
# For production: https://jackbereson.github.io
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,https://jackbereson.github.io
